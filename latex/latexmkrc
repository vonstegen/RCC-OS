# latexmk configuration for the RCC-OS documentation layer.
# Drives pdflatex with a continuous-bibe run loop for cross-references
# and bibliography.

$pdf_mode = 1;
$pdflatex = 'pdflatex -interaction=nonstopmode -halt-on-error -file-line-error %O %S';
$bibtex_use = 2;
$biber = 'biber %O %S';
$out_dir = 'build';

# Always run pdflatex twice for stable cross-references; let latexmk
# decide if a third pass is required.
$max_repeat = 5;

# Clean intermediate files but keep the PDF and the build log.
$clean_ext = 'aux bbl bcf fls fdb_latexmk run.xml synctex.gz toc log out';
